# Database Configuration
DATABASE_URL=postgresql://attendai:attendai_dev_password@postgres:5432/attendai_db
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Vapi Voice Configuration
VAPI_API_KEY=your-vapi-api-key-here
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret-here
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_BASE_URL=https://api.vapi.ai

# VoiceLink SIP Trunk Configuration (for Indian telephony)
# These are used when configuring Vapi with VoiceLink SIP trunk via API
# Run: python scripts/setup_voicelink_sip.py to configure automatically
# See: VOICELINK_SIP_INTEGRATION.md for detailed setup guide
VOICELINK_SIP_GATEWAY_IP=sip.voicelink.in
VOICELINK_SIP_PORT=5060
VOICELINK_SIP_USERNAME=your_voicelink_sip_username
VOICELINK_SIP_PASSWORD=your_voicelink_sip_password
VOICELINK_PHONE_NUMBER=+919876543210
VOICELINK_SIP_TRUNK_NAME=VoiceLink India Trunk

# LLM Provider Configuration
# Options: openai, anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM Model Configuration
LLM_EXTRACTION_MODEL=gpt-4o
LLM_VOICE_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# Call Configuration
MAX_CALL_DURATION_SECONDS=300
MAX_CALL_RETRIES=3
RETRY_DELAY_MINUTES=30
NO_ANSWER_RETRY_DELAY_MINUTES=120

# Confidence Thresholds
LOW_CONFIDENCE_THRESHOLD=0.7
REQUIRE_REVIEW_THRESHOLD=0.85

# Data Retention (days)
TRANSCRIPT_RETENTION_DAYS=90
RECORDING_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
CALL_RATE_LIMIT_PER_HOUR=100

# Frontend Configuration (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AttendAI
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Worker/Background Jobs Configuration
WORKER_CONCURRENCY=4
ENABLE_SCHEDULED_CALLS=true

# Monitoring & Health
HEALTH_CHECK_INTERVAL_SECONDS=30

# Time Zone
TZ=UTC
