# Production Environment Configuration
# Copy this file to .env.prod and fill in actual values
# NEVER commit .env.prod to version control

# Database Configuration (Production)
DATABASE_URL=postgresql://attendai_prod:STRONG_PASSWORD_HERE@postgres:5432/attendai_prod_db
DATABASE_ECHO=false
POSTGRES_DB=attendai_prod_db
POSTGRES_USER=attendai_prod
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Application Configuration
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=WARNING

# Security (MUST be strong random values, minimum 32 characters)
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Restrictive for production - only your domain)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Vapi Voice Configuration (Production credentials)
VAPI_API_KEY=YOUR_PRODUCTION_VAPI_API_KEY
VAPI_WEBHOOK_SECRET=STRONG_RANDOM_WEBHOOK_SECRET_AT_LEAST_32_CHARS
VAPI_PHONE_NUMBER_ID=YOUR_PRODUCTION_PHONE_NUMBER_ID
VAPI_BASE_URL=https://api.vapi.ai

# LLM Provider Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=YOUR_PRODUCTION_OPENAI_API_KEY
ANTHROPIC_API_KEY=

# LLM Model Configuration
LLM_EXTRACTION_MODEL=gpt-4o
LLM_VOICE_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# Call Configuration
MAX_CALL_DURATION_SECONDS=300
MAX_CALL_RETRIES=3
RETRY_DELAY_MINUTES=30
NO_ANSWER_RETRY_DELAY_MINUTES=120

# Confidence Thresholds
LOW_CONFIDENCE_THRESHOLD=0.7
REQUIRE_REVIEW_THRESHOLD=0.85

# Data Retention (days)
TRANSCRIPT_RETENTION_DAYS=90
RECORDING_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
CALL_RATE_LIMIT_PER_HOUR=100

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_NAME=AttendAI

# Worker/Background Jobs Configuration
WORKER_CONCURRENCY=4
ENABLE_SCHEDULED_CALLS=true

# Monitoring & Health
HEALTH_CHECK_INTERVAL_SECONDS=30

# Time Zone
TZ=UTC
