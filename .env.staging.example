# Staging Environment Configuration
# Copy this file to .env.staging and fill in staging-specific values
# NEVER commit .env.staging to version control
# This is for STAGING only - not production, not development

# Database Configuration (Staging)
DATABASE_URL=postgresql://attendai_staging:STAGING_DB_PASSWORD@postgres:5432/attendai_staging_db
DATABASE_ECHO=false
POSTGRES_DB=attendai_staging_db
POSTGRES_USER=attendai_staging
POSTGRES_PASSWORD=STAGING_DB_PASSWORD

# Redis Configuration (Staging)
REDIS_URL=redis://redis:6379/1

# Application Configuration
APP_ENV=staging
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Security (MUST be strong random values, minimum 32 characters)
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS_STAGING
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS_STAGING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Staging-specific domains)
CORS_ORIGINS=https://staging.yourdomain.com,https://staging-app.yourdomain.com

# Vapi Voice Configuration (Staging credentials - NOT production)
VAPI_API_KEY=YOUR_STAGING_VAPI_API_KEY
VAPI_WEBHOOK_SECRET=STAGING_RANDOM_WEBHOOK_SECRET_AT_LEAST_32_CHARS
VAPI_PHONE_NUMBER_ID=YOUR_STAGING_PHONE_NUMBER_ID
VAPI_BASE_URL=https://api.vapi.ai

# LLM Provider Configuration (Staging)
LLM_PROVIDER=openai
OPENAI_API_KEY=YOUR_STAGING_OPENAI_API_KEY
ANTHROPIC_API_KEY=

# LLM Model Configuration
LLM_EXTRACTION_MODEL=gpt-4o
LLM_VOICE_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# Call Configuration
MAX_CALL_DURATION_SECONDS=300
MAX_CALL_RETRIES=3
RETRY_DELAY_MINUTES=30
NO_ANSWER_RETRY_DELAY_MINUTES=120

# Confidence Thresholds
LOW_CONFIDENCE_THRESHOLD=0.7
REQUIRE_REVIEW_THRESHOLD=0.85

# Data Retention (days)
TRANSCRIPT_RETENTION_DAYS=90
RECORDING_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
CALL_RATE_LIMIT_PER_HOUR=100

# Frontend Configuration (Staging)
NEXT_PUBLIC_API_URL=https://staging-api.yourdomain.com
NEXT_PUBLIC_APP_NAME=AttendAI Staging

# Worker/Background Jobs Configuration
WORKER_CONCURRENCY=2
ENABLE_SCHEDULED_CALLS=true

# Monitoring & Health
HEALTH_CHECK_INTERVAL_SECONDS=30

# Time Zone
TZ=UTC

# Staging-Specific Configuration
STAGING_TEST_PHONE_NUMBER=+1234567890  # Your dedicated test number
STAGING_ADMIN_EMAIL=admin@staging.yourdomain.com
STAGING_ADMIN_PASSWORD=CHANGE_THIS_STAGING_ADMIN_PASSWORD
